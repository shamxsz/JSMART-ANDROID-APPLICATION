<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.JSMART" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="shapeAppearanceSmallComponent">@style/RoundedShape</item>
        <item name="android:background">@color/soft_white</item>
        <item name="bottomNavigationStyle">@style/BottomNavigationViewStyle</item>

        <item name="colorPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue</item>
        <item name="colorAccent">@color/light_gray</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/white</item>
        <item name="android:textColorTertiary">@color/white</item>

    </style>


    <style name="SignUpButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/blue</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="DeadlineStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/blue</item>
        <item name="strokeWidth"> 2dp</item>
        <item name="cardElevation"> 12dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="BackButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="iconTint">@color/white</item>
        <item name="background">@color/transparent</item>
    </style>

    <style name="LoginButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView.Colored">
        <item name="backgroundTint">@color/white</item>
        <item name="itemIconTint">@color/nav_bar_icon_light</item>
        <item name="itemTextColor">@color/nav_bar_text_light</item>
    </style>

    <style name="CardViewStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/light_gray</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="ExampleCardViewStyle" parent="CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/gray</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">8dp</item>

    </style>


    <style name="Theme.JSMART" parent="Base.Theme.JSMART" />
</resources>