<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ExerciseDetailActivity">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/topbar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/back"
            app:tint="@color/icon_tint" />

        <TextView
            android:id="@+id/tvExerciseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@null"
            android:text="Exercise Title"
            android:textColor="?android:textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnFeedback"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:src="@drawable/feedback"
            app:tint="@color/icon_tint" />
    </LinearLayout>


    <ScrollView
        android:id="@+id/svExerciseDetail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

                <TextView
                    android:id="@+id/tvExerciseContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:padding="4dp"
                    android:text="Exercise content will appear here..."
                    android:textColor="?android:textColorPrimary"
                    android:textSize="16sp"
                    android:background="@null"/>



            <com.amrdeveloper.codeview.CodeView
                android:id="@+id/codeView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="200dp"
                android:maxHeight="400dp"
                android:padding="12dp"
                android:gravity="top|start"
                android:background="@drawable/exercise_cardview" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRun"
                style="@style/SignUpButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Run" />


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                style="@drawable/exercise_cardview">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/exercise_cardview"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/outputConsole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="100dp"
                        android:padding="8dp"
                        android:text="Output will appear here..."
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:gravity="start|top"
                        android:background="@color/transparent" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/tvDoneAct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Done with the activity?"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="14sp"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/tvRetakeAct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Want to retake the activity?"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheck"
                        style="@style/SignUpButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Check"
                        android:textStyle="bold"
                        android:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetake"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/SignUpButtonStyle"
                        android:text="Retake Exercise"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
